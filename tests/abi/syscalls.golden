# Numéros d'appels système figés. Ajout en fin de fichier seulement.
# Un numéro retiré reste listé avec le statut retire, jamais réattribué.
# Format : numéro nom statut
0x00 SYS_EXIT actif
0x01 SYS_PROC_SPAWN actif
0x02 SYS_PROC_KILL actif
0x03 SYS_PROC_INFO actif
0x04 SYS_THREAD_CREATE actif
0x05 SYS_THREAD_EXIT actif
0x06 SYS_THREAD_PRIO actif
0x07 SYS_GETTID actif
0x08 SYS_SET_FSBASE actif
0x09 SYS_PROC_LIST actif
0x0a SYS_LOG actif
0x10 SYS_CLOSE actif
0x11 SYS_DUP actif
0x12 SYS_WAIT actif
0x13 SYS_WAIT_MANY actif
0x14 SYS_EVENT_CREATE actif
0x15 SYS_EVENT_OP actif
0x16 SYS_SECTION_CREATE actif
0x17 SYS_SECTION_MAP actif
0x19 SYS_PORT_LISTEN actif
0x1a SYS_PORT_CONNECT actif
0x1b SYS_PORT_ACCEPT actif
0x1c SYS_CHAN_SEND actif
0x1d SYS_CHAN_RECV actif
0x1e SYS_TIMER_CREATE actif
0x1f SYS_TIMER_SET actif
0x30 SYS_OPEN actif
0x31 SYS_READ actif
0x32 SYS_WRITE actif
0x33 SYS_PREAD actif
0x34 SYS_PWRITE actif
0x35 SYS_SEEK actif
0x36 SYS_STAT actif
0x37 SYS_FSTAT actif
0x38 SYS_READDIR actif
0x39 SYS_MKDIR actif
0x3a SYS_UNLINK actif
0x3b SYS_RENAME actif
0x3c SYS_FSYNC actif
0x3d SYS_TRUNCATE actif
0x50 SYS_YIELD actif
0x51 SYS_SLEEP actif
0x52 SYS_TIME_MONO actif
0x53 SYS_TIME_WALL actif
0x54 SYS_TIME_SET_WALL actif
0x58 SYS_POWER actif
0x60 SYS_DISPLAY_INFO actif
0x61 SYS_DISPLAY_MAP actif
0x62 SYS_DISPLAY_SET_MODE actif
0x63 SYS_DISPLAY_MODES actif
0x64 SYS_KCON actif
0x70 SYS_INPUT_OPEN actif
0x71 SYS_INPUT_READ actif
0x72 SYS_INPUT_LAYOUT actif
0x73 SYS_INPUT_LEDS actif
0x74 SYS_INPUT_MOUSE_CFG actif
0x80 SYS_GETRANDOM actif
0x81 SYS_SYSINFO actif
0xa0 SYS_VALLOC actif
0xa1 SYS_VFREE actif
0xa2 SYS_VPROTECT actif
0xa3 SYS_VQUERY actif
