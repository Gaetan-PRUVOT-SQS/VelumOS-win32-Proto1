# Contrat ABI des appels système, figé. Contrôlé par tests/host/a07/test_abi_golden.c
# et tests/tools/test_abi_syscalls.py.
# Un numéro retiré reste listé avec le statut retire, jamais réattribué. Ajout en fin de section.
# Les numéros libres sont déclarés en trou : en prendre un oblige à éditer cette liste.
# Format : numéro nom statut nombre_arguments
version 1
max 0xff
0x00 SYS_EXIT actif 1
0x01 SYS_PROC_SPAWN actif 5
0x02 SYS_PROC_KILL actif 2
0x03 SYS_PROC_INFO actif 3
0x04 SYS_THREAD_CREATE actif 5
0x05 SYS_THREAD_EXIT actif 1
0x06 SYS_THREAD_PRIO actif 2
0x07 SYS_GETTID actif 0
0x08 SYS_SET_FSBASE actif 1
0x09 SYS_PROC_LIST actif 2
0x0a SYS_LOG actif 3
0x10 SYS_CLOSE actif 1
0x11 SYS_DUP actif 2
0x12 SYS_WAIT actif 2
0x13 SYS_WAIT_MANY actif 4
0x14 SYS_EVENT_CREATE actif 2
0x15 SYS_EVENT_OP actif 2
0x16 SYS_SECTION_CREATE actif 2
0x17 SYS_SECTION_MAP actif 5
0x19 SYS_PORT_LISTEN actif 3
0x1a SYS_PORT_CONNECT actif 3
0x1b SYS_PORT_ACCEPT actif 2
0x1c SYS_CHAN_SEND actif 2
0x1d SYS_CHAN_RECV actif 2
0x1e SYS_TIMER_CREATE actif 1
0x1f SYS_TIMER_SET actif 3
0x30 SYS_OPEN actif 4
0x31 SYS_READ actif 3
0x32 SYS_WRITE actif 3
0x33 SYS_PREAD actif 4
0x34 SYS_PWRITE actif 4
0x35 SYS_SEEK actif 3
0x36 SYS_STAT actif 3
0x37 SYS_FSTAT actif 2
0x38 SYS_READDIR actif 3
0x39 SYS_MKDIR actif 3
0x3a SYS_UNLINK actif 2
0x3b SYS_RENAME actif 4
0x3c SYS_FSYNC actif 1
0x3d SYS_TRUNCATE actif 2
0x50 SYS_YIELD actif 0
0x51 SYS_SLEEP actif 1
0x52 SYS_TIME_MONO actif 0
0x53 SYS_TIME_WALL actif 0
0x54 SYS_TIME_SET_WALL actif 1
0x58 SYS_POWER actif 1
0x60 SYS_DISPLAY_INFO actif 1
0x61 SYS_DISPLAY_MAP actif 1
0x62 SYS_DISPLAY_SET_MODE actif 3
0x63 SYS_DISPLAY_MODES actif 2
0x64 SYS_KCON actif 1
0x70 SYS_INPUT_OPEN actif 1
0x71 SYS_INPUT_READ actif 3
0x72 SYS_INPUT_LAYOUT actif 3
0x73 SYS_INPUT_LEDS actif 1
0x74 SYS_INPUT_MOUSE_CFG actif 2
0x80 SYS_GETRANDOM actif 3
0x81 SYS_SYSINFO actif 1
0xa0 SYS_VALLOC actif 3
0xa1 SYS_VFREE actif 2
0xa2 SYS_VPROTECT actif 3
0xa3 SYS_VQUERY actif 2
0xbc SYS_MEMINFO actif 1
trou 0x0b 0x0f
trou 0x18 0x18
trou 0x20 0x2f
trou 0x3e 0x4f
trou 0x55 0x57
trou 0x59 0x5f
trou 0x65 0x6f
trou 0x75 0x7f
trou 0x82 0x9f
trou 0xa4 0xbb
trou 0xbd 0xfe
taille t_vstat 40
taille t_dirent 272
taille t_procinfo 80
taille t_sysinfo 160
taille t_dispinfo 32
taille t_dispmode 16
taille t_chansend 32
taille t_chanrecv 56
taille t_inpevent 32
